{
  "name": "inara-network",
  "version": "1.0.0",
  "description": "The International Network for Aid, Relief and Assistance - A coordination platform for humanitarian organizations",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "node --test",
    "test:integration": "bash -lc 'npx prisma db push --accept-data-loss && npm run seed && npm run build && npm start & npx wait-on http://localhost:3000 && node --test tests/integration'",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "next": "^16.0.7",
    "next-auth": "^4.24.5",
    "prisma": "^5.22.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.49.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.5.1",
    "socket.io-client": "^4.6.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.7",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.7",
    "postcss": "^8.4.32",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "wait-on": "^9.0.3"
  }
}
